# ==========================================
# MITS ONE — Environment Configuration
# ==========================================

# Application
PROJECT_NAME="MITS ONE"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Institution Details
INSTITUTION_NAME="Madhav Institute of Technology and Science, Gwalior"
DEPARTMENT_NAME="Mathematics and Computing"
PROJECT_MENTOR="Dr. Dheeraj Dixit (HOD)"

# Security (JWT & Password Hashing)
# Generate a secure 32+ char key in production: openssl rand -hex 32
SECRET_KEY="mits-one-super-secret-development-security-key-team-nexora"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local PostgreSQL: postgresql+psycopg2://<user>:<password>@localhost:5432/mits_one_db
# For SQLite offline testing: sqlite:///./mits_one.db
DATABASE_URL="sqlite:///./mits_one.db"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# AI Service (Phase 4)
GEMINI_API_KEY=""
